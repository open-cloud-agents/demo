# OsX ignores
.DS_Store
._*
.Spotlight-V100
.Trashes

# VSCode ignores
.vscode/*
!.vscode/settings.json

# Terraform ignores
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!terraform.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
.terraformrc
terraform.rc

# Plan artefacts. plan.txt is committed deliberately (generated by CI); the
# binary plan and its JSON rendering are not.
tfplan
*.plan
plan.json
